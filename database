-- View all members
SELECT * FROM members;

-- View all books
SELECT * FROM books;

-- Issue a book
INSERT INTO issue_books (member_id, book_id, issue_date)
VALUES (1, 1, CURDATE());

-- Update available book quantity after issue
UPDATE books
SET available_quantity = available_quantity - 1
WHERE book_id = 1 AND available_quantity > 0;

-- View issued books
SELECT 
    i.issue_id,
    m.name AS member_name,
    b.title AS book_name,
    i.issue_date,
    i.return_date,
    i.status
FROM issue_books i
JOIN members m ON i.member_id = m.member_id
JOIN books b ON i.book_id = b.book_id;

-- Return a book
UPDATE issue_books
SET return_date = CURDATE(),
    status = 'Returned'
WHERE issue_id = 1;

-- Increase available quantity after return
UPDATE books
SET available_quantity = available_quantity + 1
WHERE book_id = 1;

-- Search book
SELECT * FROM books
WHERE title LIKE '%Python%';

